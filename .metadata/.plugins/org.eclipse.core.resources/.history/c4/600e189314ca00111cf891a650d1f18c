spring.application.name=ApiGateway
server.port=2000

# Configure Student API
spring.cloud.gateway.routes[0].id=StudentApi
spring.cloud.gateway.routes[0].uri=http://localhost:2020
spring.cloud.gateway.routes[0].predicates[0]=Path=/students/**

# Configure Marks API
spring.cloud.gateway.routes[1].id=MarksApi
spring.cloud.gateway.routes[1].uri=http://localhost:2021
spring.cloud.gateway.routes[1].predicates[0]=Path=/marks/**